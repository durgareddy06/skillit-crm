# Copy this file to .env and fill in your own values.

# Local MongoDB (default if you installed MongoDB Community Server locally):
MONGO_URI=mongodb://127.0.0.1:27017/skillit-fbcrm

# Or a MongoDB Atlas connection string, e.g.:
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/skillit-fbcrm

JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d
PORT=4000

# Razorpay Credentials
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_key_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret


# Webhook Auth Security
WEBHOOK_API_KEY=your_webhook_api_key_here
WEBHOOK_SECRET=your_webhook_secret_here

# n8n Webhook Endpoint URLs
N8N_STUDENT_WEBHOOK_URL=http://localhost:5678/webhook-test/student
N8N_PAYMENT_WEBHOOK_URL=http://localhost:5678/webhook/payment
N8N_EMAIL_OUTBOX_WEBHOOK_URL=http://localhost:5678/webhook/email-outbox
N8N_TOKEN_RESOLVED_WEBHOOK_URL=http://localhost:5678/webhook/token-resolved
