# ==============================================================================
# SKILLIT CRM - CENTRALIZED BACKEND CONFIGURATION (.env.example)
# ==============================================================================

# ==============================================================================
# #1 DATABASE & CORE SERVER CONFIGURATION
# ==============================================================================
MONGO_URI=mongodb://127.0.0.1:27017/skillit-fbcrm
PORT=4000
FRONTEND_URL=http://localhost:5174

# ==============================================================================
# #2 AUTHENTICATION & FORGOT PASSWORD MODULE
# ==============================================================================
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ==============================================================================
# #3 CENTRALIZED EMAIL SERVICE (STUDENT, PAYMENT, WORKFLOW & SUPPORT NOTIFICATIONS)
# ==============================================================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=support@skillit.com
MAIL_PASSWORD=your_app_password_here
MAIL_FROM="SkillIT Academy <noreply@skillit.com>"

# ==============================================================================
# #4 PAYMENT MODULE INTEGRATION (RAZORPAY CHECKOUT & REFUNDS)
# ==============================================================================
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_key_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# ==============================================================================
# #5 TOKENS (SUPPORT) MODULE & INBOX MONITORING (IMAP AUTO-ROUTING)
# Inboxes Monitored: support@skillit.com, tech@skillit.com, rm@skillit.com
# ==============================================================================
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=support@skillit.com
IMAP_PASSWORD=your_app_password_here
ALLOW_UNKNOWN_SENDER=false
